@model IReadOnlyCollection<ExchangeRateDto>
@{
    ViewData["Title"] = "汇率管理";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">ADMIN · EXCHANGE RATES</span>
        <h1>汇率管理</h1>
        <p>人民币为本币；汇率定义为 1 单位外币可以兑换多少人民币。</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">新增汇率</a>
</div>

<div class="content-card table-responsive">
    <table class="table align-middle mb-0">
        <thead><tr><th>币种</th><th>名称</th><th class="text-end">兑换人民币</th><th class="text-end">操作</th></tr></thead>
        <tbody>
        @foreach (var rate in Model)
        {
            <tr>
                <td><span class="type-pill">@rate.CurrencyCode</span></td>
                <td class="fw-semibold">@rate.CurrencyName</td>
                <td class="text-end">1 @rate.CurrencyCode = ¥ @rate.CnyPerUnit.ToString("N6")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@rate.Id">编辑</a>
                    <form asp-action="Delete" asp-route-id="@rate.Id" method="post" class="d-inline"
                          onsubmit="return confirm('确定删除 @rate.CurrencyCode 汇率吗？历史报价不会受影响。');">
                        <button class="btn btn-sm btn-outline-danger" type="submit">删除</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
