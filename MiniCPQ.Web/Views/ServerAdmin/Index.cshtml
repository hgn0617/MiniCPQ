@model IReadOnlyCollection<ServerDto>
@{
    ViewData["Title"] = "服务器配置";
}

<div class="page-heading">
    <div><span class="eyebrow">ADMIN · SERVERS</span><h1>服务器配置</h1><p>组合硬件材料；服务器成本不落库，始终按当前材料价格计算。</p></div>
    <a class="btn btn-primary" asp-action="Create">新增服务器</a>
</div>

<div class="server-grid">
@foreach (var server in Model)
{
    <article class="content-card server-card">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div><span class="type-pill">SERVER</span><h2>@server.Name</h2></div>
            <div class="server-price"><small>当前成本</small><strong>¥ @server.CurrentCost.ToString("N2")</strong></div>
        </div>
        <ul class="component-list">
        @foreach (var component in server.Materials)
        {
            <li><span>@component.Name <small>@component.Type</small></span><b>× @component.Quantity</b></li>
        }
        </ul>
        <div class="d-flex gap-2 justify-content-end">
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@server.Id">编辑配置</a>
            <form asp-action="Delete" asp-route-id="@server.Id" method="post" onsubmit="return confirm('确定删除 @server.Name 吗？');">
                <button class="btn btn-sm btn-outline-danger" type="submit">删除</button>
            </form>
        </div>
    </article>
}
</div>
