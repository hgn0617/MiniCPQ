@model ServerFormViewModel
@{
    ViewData["Title"] = "编辑服务器";
}

<div class="page-heading"><div><span class="eyebrow">SERVER</span><h1>编辑服务器配置</h1><p>配置更新会影响以后提交的报价，不会改变已有历史快照。</p></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="content-card form-card form-card-wide">
    <input asp-for="Id" type="hidden" />
    <partial name="_FormFields" model="Model" />
    <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">保存修改</button><a class="btn btn-outline-secondary" asp-action="Index">取消</a></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
