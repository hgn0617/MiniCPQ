<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini CPQ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">M</span> Mini CPQ
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="展开导航">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">工作台</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="QuotePortal" asp-action="Index">报价单</a></li>
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="MaterialAdmin" asp-action="Index">材料管理</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="ServerAdmin" asp-action="Index">服务器配置</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="ExchangeRateAdmin" asp-action="Index">汇率管理</a></li>
                            }
                        }
                        <li class="nav-item"><a class="nav-link" href="/swagger">Swagger</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 text-white">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="small opacity-75">@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-light">退出</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Login">登录</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container app-main">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="关闭"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="关闭"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container d-flex justify-content-between">
            <span>Mini CPQ 服务器报价系统</span>
            <span>ASP.NET Core MVC · PostgreSQL</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
