@model MaterialFormViewModel
@{
    ViewData["Title"] = "编辑材料";
}

<div class="form-page">
    <div class="page-heading"><div><span class="eyebrow">MATERIAL</span><h1>编辑材料</h1><p>保存时会检查版本，防止覆盖其他管理员的修改。</p></div></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="content-card form-card">
        <input asp-for="Id" type="hidden" />
        <input asp-for="Version" type="hidden" />
        <partial name="_FormFields" model="Model" />
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">保存修改</button>
            <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
