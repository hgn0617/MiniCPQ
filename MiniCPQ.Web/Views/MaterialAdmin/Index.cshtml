@model IReadOnlyCollection<MaterialDto>
@{
    ViewData["Title"] = "材料管理";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">ADMIN · MATERIALS</span>
        <h1>硬件材料</h1>
        <p>维护服务器配置所使用的基础材料和当前单价。</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">新增材料</a>
</div>

<div class="content-card table-responsive">
    <table class="table align-middle mb-0">
        <thead>
            <tr><th>名称</th><th>类型</th><th class="text-end">当前单价</th><th class="text-end">操作</th></tr>
        </thead>
        <tbody>
        @foreach (var material in Model)
        {
            <tr>
                <td class="fw-semibold">@material.Name</td>
                <td><span class="type-pill">@material.Type</span></td>
                <td class="text-end price-text">¥ @material.UnitPrice.ToString("N2")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@material.Id">编辑</a>
                    <form asp-action="Delete" asp-route-id="@material.Id" method="post" class="d-inline"
                          onsubmit="return confirm('确定删除 @material.Name 吗？');">
                        <button class="btn btn-sm btn-outline-danger" type="submit">删除</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
